#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * roBa キーマップ — Mac 専用版
 *
 * ┌ レイヤー一覧 ────────────────────────────────┐
 * │ 0 BASE      … 通常                            │
 * │ 1 FUNCTION  … F1-F12＋Bluetooth（Enter長押し） │
 * │ 2 NUM       … 数字・記号（Space長押し）        │
 * │ 3 ARROW     … 移動・編集・スクショ（英数長押し） │
 * │ 4 MOUSE     … ボール操作で自動                 │
 * │ 5 SCROLL    … スクロール（I または M 長押し）   │
 * │ 6 EXCEL     … Excelショートカット（「ー」長押し）│
 * └──────────────────────────────────────────────┘
 *
 * 親指（左）: [Space] [⌘] [⌥] [画面切替] [かな] [英数]
 *   Space長押し=数字 / 英数長押し=矢印 / 画面切替=次の画面(⌃→)、英数＋同キー=前の画面(⌃←)
 * 親指（右）: [⌫] [Enter] [右クリック]   Enter長押し=Fn
 *
 * コピー/ペースト: 親指の ⌘ ＋ C / V
 * クリック: トラックボール脇のキー=左クリック（常時）、最右下=右クリック（常時）
 *           ボール操作中は J/K/L も 左/中/右クリック
 * Aqua Voice: 左内側の下のキー（⌃⌥A）
 *
 * ※ 位置15（左内側の上）はダイヤルの場所で物理キーが無いため全レイヤーで &none
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/* レイヤーキーは押しながら次のキーを押せば即レイヤーに入る */
&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <11 10>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <0 1>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                                    &kp T                                            &kp Y          &kp U        &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                                    &kp G        &none                               &lt 6 MINUS    &kp H          &kp J        &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                                    &kp B        &kp LC(LA(A))                       &mkp MB1       &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH
&lt 2 SPACE       &kp LEFT_GUI  &kp LEFT_ALT  &kp LC(RIGHT_ARROW)                      &kp LANG1    &lt_to_layer_0 3 LANG2              &kp BACKSPACE  &lt 1 ENTER                                      &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        FUNCTION {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                        &kp F1   &kp F2  &kp F3  &kp F4  &kp F5
&trans        &trans        &trans         &trans        &trans  &none           &kp F13      &kp F6   &kp F7  &kp F8  &kp F9  &kp F10
&bootloader   &bt BT_CLR    &bt BT_CLR_ALL &trans        &trans  &trans          &trans       &trans   &trans  &trans  &trans  &kp F11
&trans        &trans        &trans         &trans        &trans  &trans          &trans       &trans                           &kp F12
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NUM {
            bindings = <
&kp MINUS               &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS                                    &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH               &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &none           &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT NUMBER_0 &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp EQUAL       &kp SEMICOLON   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                  &trans        &trans        &trans        &trans        &trans          &trans          &trans                                                                     &kp PIPE
            >;
        };

        /* 左手=カーソル / 右手 YUIO=⌘+矢印（Excelでセルの切れ目までジャンプ） / 内側キー=スクショ */
        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW          &kp LC(TAB)              &kp LG(W)                                  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)    &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)    &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW        &kp RIGHT_ARROW          &kp END       &none                        &trans              &kp LG(LEFT_BRACKET)  &trans            &trans  &kp LG(RIGHT_BRACKET)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &kp LG(LS(NUMBER_4))  &kp LG(LS(RIGHT_ARROW))  &trans        &kp LC(LG(LS(NUMBER_4)))     &trans              &trans                &trans            &trans  &trans                 &trans
&trans          &trans                  &trans                &kp LC(LEFT_ARROW)       &trans        &trans                       &trans              &trans                                                           &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &lt 5 M   &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(Z)) LG(Z)>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        /*
         * EXCEL（Mac版 Excel のショートカット）— 右手で「ー」を押さえたまま左手で叩く
         *  Q=F2 セル編集   W=⌘T 絶対参照   E=⌘1 書式   R=⌘⇧F フィルタ   T=⌘⌃V 形式貼付
         *  A=⌘F 検索       S=⌃H 置換       D=⇧Space 行選択  F=⌃Space 列選択  G=⌥Enter セル内改行
         *  Z=⌃I 行列追加   X=⌃- 行列削除   C=⌃Enter 一括入力  V=⌥← 前シート  B=⌥→ 次シート
         */
        EXCEL {
            bindings = <
&kp F2        &kp LG(T)      &kp LG(NUMBER_1)  &kp LG(LS(F))        &kp LG(LC(V))                              &trans  &trans  &trans  &trans  &trans
&kp LG(F)     &kp LC(H)      &kp LS(SPACE)     &kp LC(SPACE)        &kp LA(ENTER)        &none          &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(I)     &kp LC(MINUS)  &kp LC(ENTER)     &kp LA(LEFT_ARROW)   &kp LA(RIGHT_ARROW)  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans         &trans            &trans               &trans               &trans         &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LA(LEFT_ARROW) LA(RIGHT_ARROW)>;
        };
    };
};
