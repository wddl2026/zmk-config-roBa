#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * roBa キーマップ — Mac / Windows 両対応版
 *
 * 普段は Mac 配列（レイヤー0）。Win モード（レイヤー6）をトグルONにすると、
 * OSで挙動が違うキーだけが上書きされ、同じ指の位置で Win 用の動作になる。
 *
 * ┌ レイヤー一覧 ──────────────────────────────────┐
 * │ 0 MAC_BASE   … Mac ベース（デフォルト）          │
 * │ 1 FUNCTION   … F1-F12＋Bluetooth＋OS切替（Enter長押し）│
 * │ 2 NUM        … 数字・記号（Space長押し／共通）    │
 * │ 3 ARROW_MAC  … 移動・編集 Mac版（英数長押し）     │
 * │ 4 MOUSE      … ボール操作で自動（共通）          │
 * │ 5 SCROLL     … スクロール（共通）                │
 * │ 6 WIN_OVL    … Windows差分オーバーレイ（トグル）  │
 * │ 7 ARROW_WIN  … 移動・編集 Win版（無変換長押し）   │
 * └──────────────────────────────────────────────┘
 *
 * Win モード切替: Enter長押し → 左手Aの位置（&tog 6）。もう一度で Mac に戻る。
 * ※ Windows 側の IME は「無変換=IMEオフ / 変換=IMEオン」に設定しておくと
 *    Mac の 英数/かな と同じ操作感になる（Microsoft IME のキー設定）。
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <11 10>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <0 1>;
        };

        // コピー = X+C 同時押し（左手下段）。内側の⌘Cキーはダイヤル位置で物理キーが無いため
        copy {
            bindings = <&kp LG(C)>;
            key-positions = <23 24>;
        };

        // ペースト = V+B 同時押し（左手下段）。内側の⌘Vキーはトラックボール位置で物理キーが無いため
        paste {
            bindings = <&kp LG(V)>;
            key-positions = <25 26>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                     &kp T                                                       &kp Y          &kp U        &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                     &kp G        &kp LG(C)                       &kp MINUS      &kp H          &kp J        &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                     &kp B        &kp LC(LA(A))                   &kp LG(V)      &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH
&lt 2 SPACE       &kp LEFT_WIN  &kp LEFT_ALT  &kp LC(LEFT_ARROW)        &kp LC(RIGHT_ARROW)      &lt_to_layer_0 3 LANG2      &kp BACKSPACE  &lt 1 ENTER                                      &kp LANG1
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        FUNCTION {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                        &kp F1   &kp F2  &kp F3  &kp F4  &kp F5
&tog 6        &trans        &trans         &trans        &trans  &trans          &kp F13      &kp F6   &kp F7  &kp F8  &kp F9  &kp F10
&bootloader   &bt BT_CLR    &bt BT_CLR_ALL &trans        &trans  &trans          &trans       &trans   &trans  &trans  &trans  &kp F11
&trans        &trans        &trans         &trans        &trans  &trans          &trans       &trans                           &kp F12
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &kp SEMICOLON   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW_MAC {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LG(W)                                  &trans  &trans                &trans  &trans                 &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &kp LC(LG(LS(NUMBER_4)))   &trans  &kp LG(LEFT_BRACKET)  &trans  &trans  &kp LG(RIGHT_BRACKET)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &kp LG(LS(NUMBER_4))       &trans  &trans                &trans  &trans  &trans                 &trans
&trans          &trans                  &trans          &trans                   &trans   &trans                     &trans  &trans                                                       &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &lt 5 M   &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(Z)) LG(Z)>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        /* Windows 差分オーバーレイ: OSで違うキーだけ上書き。&trans は Mac ベースが透けて見える */
        WIN_OVL {
            bindings = <
&trans  &trans          &trans        &trans              &trans                                                       &trans      &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans              &trans              &kp LC(C)                    &trans      &trans      &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans              &trans              &kp LG(H)                    &kp LC(V)   &trans      &trans  &trans  &trans  &trans
&trans  &kp LEFT_CONTROL &trans       &kp LG(LC(LEFT))    &kp LG(LC(RIGHT))   &lt 7 INT_MUHENKAN           &trans      &trans                              &kp INT_HENKAN
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        ARROW_WIN {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LC(W)                                  &trans  &trans          &trans  &trans          &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &kp LG(LS(S))              &trans  &kp LA(LEFT_ARROW)  &trans  &trans  &kp LA(RIGHT_ARROW)  &trans
&kp LEFT_SHIFT  &kp LC(LS(LEFT_ARROW))  &trans          &kp LC(LS(RIGHT_ARROW))  &trans   &kp LG(PRINTSCREEN)        &trans  &trans          &trans  &trans  &trans          &trans
&trans          &trans                  &trans          &trans                   &trans   &trans                     &trans  &trans                                          &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
