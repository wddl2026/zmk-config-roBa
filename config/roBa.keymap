#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * roBa キーマップ — Mac / Windows 両対応版（ベース切替式）＋ Excel レイヤー
 *
 * ┌ レイヤー一覧 ──────────────────────────────────┐
 * │ 0 MAC_BASE   … Mac ベース（デフォルト）          │
 * │ 1 WIN_BASE   … Windows ベース                    │
 * │ 2 FUNCTION   … F1-F12＋Bluetooth＋OS切替（Enter長押し）│
 * │ 3 NUM        … 数字・記号（Space長押し／共通）    │
 * │ 4 MOUSE      … ボール操作で自動（共通）          │
 * │ 5 SCROLL     … スクロール（共通）                │
 * │ 6 ARROW_MAC  … 移動・編集 Mac版（英数長押し）     │
 * │ 7 ARROW_WIN  … 移動・編集 Win版（無変換長押し）   │
 * │ 8 EXCEL      … Excelショートカット（「ー」長押し）│
 * └──────────────────────────────────────────────┘
 *
 * OS切替: Enter長押し（FUNCTION）→（左手）A = Windows へ / S = Mac へ
 * コピー/ペースト: 左親指の修飾キー（Mac=⌘ / Win=Ctrl に自動で変わる）＋ C / V
 * Excel: 右手の「ー」キーを長押し → 左手がExcelショートカットのコマンドパッドになる
 *
 * ※ 物理キーが無い2箇所は &none（キー位置15＝左内側上＝ダイヤル / 位置28＝右内側下＝トラックボール）
 * ※ Windows 側の IME は「無変換=IMEオフ / 変換=IMEオン」に設定推奨（Microsoft IME）。
 * ※ Excelレイヤーのリボン系（ピボット等）は Windows版Excel 専用。
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <11 10>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <0 1>;
        };

        /*
         * コピー/ペーストはコンボにしない。
         * ZMK の &to はレイヤー0を常時有効のまま残す仕様のため、
         * layers= でOS別に分けたコンボは Windows モードで両方有効になり競合する。
         * → 左親指の修飾キー（Mac=⌘ / Win=Ctrl に自動で変わる）＋ C / V を使う。
         */

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        /* Windows版Excel のリボン順次押しショートカット */
        xl_pivot: xl_pivot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(D) &kp P>;
            label = "XL_PIVOT";
            wait-ms = <40>;
            tap-ms = <40>;
        };

        xl_freeze: xl_freeze {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(W) &kp F &kp F>;
            label = "XL_FREEZE";
            wait-ms = <40>;
            tap-ms = <40>;
        };

        xl_clear: xl_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp E &kp A>;
            label = "XL_CLEAR";
            wait-ms = <40>;
            tap-ms = <40>;
        };

        xl_colfit: xl_colfit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(O) &kp C &kp A>;
            label = "XL_COLFIT";
            wait-ms = <40>;
            tap-ms = <40>;
        };

        xl_rowfit: xl_rowfit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(O) &kp R &kp A>;
            label = "XL_ROWFIT";
            wait-ms = <40>;
            tap-ms = <40>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC_BASE {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                     &kp T                                                       &kp Y          &kp U        &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                     &kp G        &none                           &lt 8 MINUS    &kp H          &kp J        &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                     &kp B        &kp LC(LA(A))                   &none          &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH
&lt 3 SPACE       &kp LEFT_WIN  &kp LEFT_ALT  &kp LC(LEFT_ARROW)        &kp LC(RIGHT_ARROW)      &lt_to_layer_0 6 LANG2      &kp BACKSPACE  &lt 2 ENTER                                      &kp LANG1
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        WIN_BASE {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                     &kp T                                                       &kp Y          &kp U        &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                     &kp G        &none                           &lt 8 MINUS    &kp H          &kp J        &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                     &kp B        &kp LG(H)                       &none          &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH
&lt 3 SPACE       &kp LEFT_CONTROL &kp LEFT_ALT &kp LA(LS(TAB))        &kp LA(TAB)              &lt 7 INT_MUHENKAN          &kp BACKSPACE  &lt 2 ENTER                                      &kp INT_HENKAN
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        FUNCTION {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                        &kp F1   &kp F2  &kp F3  &kp F4  &kp F5
&to 1         &to 0         &trans         &trans        &trans  &none           &kp F13      &kp F6   &kp F7  &kp F8  &kp F9  &kp F10
&bootloader   &bt BT_CLR    &bt BT_CLR_ALL &trans        &trans  &trans          &none        &trans   &trans  &trans  &trans  &kp F11
&trans        &trans        &trans         &trans        &trans  &trans          &trans       &trans                           &kp F12
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &none           &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp SEMICOLON   &none           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans          &trans          &trans                                                                     &kp PIPE
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &none   &trans  &lt 5 M   &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(Z)) LG(Z)>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &none   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        /* 右手 YUIO = ⌘+矢印（Excelでセルの切れ目までジャンプ） */
        ARROW_MAC {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LG(W)                                      &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END       &none                     &trans  &kp LG(LEFT_BRACKET)  &trans  &trans  &kp LG(RIGHT_BRACKET)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &kp LG(LS(NUMBER_4))  &kp LG(LS(RIGHT_ARROW))  &trans  &kp LC(LG(LS(NUMBER_4)))  &none   &trans                &trans  &trans  &trans                 &trans
&trans          &trans                  &trans          &trans                   &trans        &trans                    &trans  &trans                                                       &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        /* 右手 YUIO = Ctrl+矢印（Excelでセルの切れ目までジャンプ） */
        ARROW_WIN {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LC(W)                                      &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END       &none                &trans  &kp LA(LEFT_ARROW)  &trans  &trans  &kp LA(RIGHT_ARROW)  &trans
&kp LEFT_SHIFT  &kp LC(LS(LEFT_ARROW))  &kp LG(PRINTSCREEN)  &kp LC(LS(RIGHT_ARROW))  &trans   &kp LG(LS(S))        &none   &trans              &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &trans               &trans
&trans          &trans                  &trans          &trans                   &trans        &trans               &trans  &trans                                                   &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        /*
         * EXCEL レイヤー（「ー」キー長押し中）
         * 右手で「ー」を押さえたまま、左手だけでExcelの主要ショートカットを叩く。
         * リボン順次押し（ピボット・ウィンドウ固定・クリア・幅最適化）はマクロ化。
         */
        EXCEL {
            bindings = <
&kp F2          &kp F4           &kp LC(NUMBER_1)  &kp LC(LS(L))     &kp LC(LA(V))                             &trans  &trans  &trans  &trans  &trans
&kp LC(F)       &kp LC(H)        &kp LS(SPACE)     &kp LC(SPACE)     &kp LA(ENTER)   &none          &trans     &trans  &trans  &trans  &trans  &trans
&kp LC(LS(EQUAL)) &kp LC(MINUS)  &kp LC(ENTER)     &kp LC(PAGE_UP)   &kp LC(PAGE_DOWN) &xl_pivot    &none      &trans  &trans  &trans  &trans  &trans
&xl_freeze      &xl_clear        &xl_colfit        &xl_rowfit        &trans          &trans         &trans     &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
